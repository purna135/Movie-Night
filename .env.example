# Copy this file to ".env" (same folder) and fill in what you need.
# .env is git-ignored, so your credentials never get pushed to GitHub.

# Keep the same passcode across restarts (otherwise a random 6-digit code is made each time)
# PASSCODE=246810

# Local port (default 8787; moves to the next free port automatically)
# PORT=8787

# Optional TURN relay for better voice on networks that block direct connections.
# Several addresses can be listed, separated by commas. Example for metered.ca:
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USER=your-username
# TURN_PASS=your-credential
